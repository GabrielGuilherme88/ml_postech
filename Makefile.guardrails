# Makefile exclusivo para o teste do guardrails

PYTHON = ambi/bin/python

.PHONY: test

test: setup-spacy
	@echo "🛡️ Rodando testes exclusivos de Guardrails..."
	$(PYTHON) -m pytest -s -q --disable-warnings tests/test_guardrails_unit.py
	$(PYTHON) -m pytest -s -q --disable-warnings tests/test_ana_security.py
	@echo "\n✅ Todos os testes de segurança foram concluídos com sucesso!"

setup-spacy:
	@$(PYTHON) -c "import pt_core_news_lg" 2>/dev/null || (echo "⬇️ Baixando modelo de idioma do spaCy (pt_core_news_lg)..." && $(PYTHON) -m spacy download pt_core_news_lg || echo "Aviso: Falha ao baixar o modelo spaCy.")
