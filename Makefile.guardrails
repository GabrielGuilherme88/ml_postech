# Makefile exclusivo para o teste do guardrails

PYTHON = ambi/bin/python

.PHONY: test

test: setup-spacy
	@echo "🛡️ Rodando testes exclusivos de Guardrails..."
	$(PYTHON) -m pytest tests/test_guardrails_unit.py
	$(PYTHON) -m pytest tests/test_ana_security.py
	@echo "✅ Testes de Guardrails concluídos!"

setup-spacy:
	@echo "⬇️ Garantindo que o modelo de idioma do spaCy (pt_core_news_lg) esteja instalado..."
	$(PYTHON) -m spacy download pt_core_news_lg || echo "Aviso: Falha ao baixar o modelo spaCy. Os testes de PII podem falhar."
